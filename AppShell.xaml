<?xml version="1.0" encoding="UTF-8" ?>
<!-- Main shell: tab bar (Search, Collection, Stats, Decks, Settings). Tab content is assigned in AppShell.xaml.cs from DI. -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:icons="clr-namespace:AetherVault.Core"
       x:Class="AetherVault.AppShell"
       Title="AetherVault"
       Shell.BackgroundColor="{StaticResource Surface}"
       Shell.ForegroundColor="{StaticResource TextPrimary}">

    <TabBar>
        <ShellContent
            x:Name="SearchTab"
            Title="Search"
            Icon="{x:Static icons:Icons.Search}" />

        <ShellContent
            x:Name="CollectionTab"
            Title="Collection"
            Icon="{x:Static icons:Icons.Collection}" />

        <ShellContent
            x:Name="StatsTab"
            Title="Stats"
            Icon="{x:Static icons:Icons.Stats}" />

        <ShellContent
            x:Name="DecksTab"
            Title="Decks"
            Icon="{x:Static icons:Icons.Decks}" />

        <ShellContent
            x:Name="SettingsTab"
            Title="Settings"
            Icon="{x:Static icons:Icons.Settings}" />
    </TabBar>

    <Shell.FlyoutBehavior>Disabled</Shell.FlyoutBehavior>

</Shell>
