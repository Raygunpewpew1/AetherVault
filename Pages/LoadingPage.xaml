<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AetherVault.ViewModels"
             x:Class="AetherVault.Pages.LoadingPage"
             x:Name="SplashRoot"
             NavigationPage.HasNavigationBar="False">

    <Grid Background="{StaticResource SplashGradient}" Padding="24">
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0" MaximumWidthRequest="360">
            <!-- Logo / brand mark -->
            <Border x:Name="LogoBorder"
                    WidthRequest="100"
                    HeightRequest="100"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{StaticResource Surface}"
                    HorizontalOptions="Center"
                    Margin="0,0,0,24"
                    Opacity="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,0" Radius="20" Opacity="0.15" />
                </Border.Shadow>
                <Label Text="A"
                       FontFamily="SerifFontBold"
                       FontSize="48"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- App name -->
            <Label x:Name="TitleLabel"
                   Text="AetherVault"
                   FontFamily="SerifFontBold"
                   FontSize="42"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,8"
                   Opacity="0" />

            <!-- Tagline -->
            <Label x:Name="TaglineLabel"
                   Text="No account, no cloud, no life-counter"
                   FontSize="15"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,48"
                   Opacity="0" />

            <!-- Progress section -->
            <Grid x:Name="ProgressSection" IsVisible="{Binding IsBusy}" Opacity="0" Margin="0,0,0,16" WidthRequest="280" HorizontalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Progress="{Binding Progress}"
                             ProgressColor="{StaticResource Primary}"
                             HeightRequest="6"
                             VerticalOptions="Center"
                             Margin="0,0,12,0" />
                <Label Grid.Column="1"
                       Text="{Binding ProgressPercent, StringFormat='{0}%'}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       VerticalOptions="Center"
                       MinimumWidthRequest="36"
                       HorizontalTextAlignment="End" />
            </Grid>

            <!-- Status message -->
            <Label Text="{Binding StatusDisplayText}"
                   TextColor="{Binding StatusTextColor}"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   MaxLines="2"
                   LineBreakMode="TailTruncation"
                   Margin="0,0,0,12" />

            <!-- MTG fact / tip -->
            <Label Text="{Binding TipText}"
                   FontSize="13"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   MaxLines="3"
                   LineBreakMode="WordWrap"
                   Margin="0,0,0,24" />

            <!-- Retry button — colors from implicit Button (Primary / OnPrimary) -->
            <Button Text="Retry download"
                    Command="{Binding RetryCommand}"
                    IsVisible="{Binding ShowRetry}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
