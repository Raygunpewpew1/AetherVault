<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:AetherVault.Core"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             xmlns:vm="clr-namespace:AetherVault.ViewModels"
             x:Class="AetherVault.Pages.CollectionPage"
             x:Name="CollectionPageRoot"
             x:DataType="vm:CollectionViewModel"
             Title="Collection"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0"
                             Padding="{StaticResource ThicknessPageChrome}"
                             Spacing="{StaticResource Spacing12}">

            <controls:PageHeader Title="Collection" />

            <controls:SearchBarRow Text="{Binding SearchText, Mode=TwoWay}"
                                   Placeholder="Name">
                <controls:SearchBarRow.Actions>
                    <HorizontalStackLayout Spacing="{StaticResource Spacing4}"
                                           VerticalOptions="Center">
                        <controls:IconButton Glyph="{x:Static icons:Icons.Filter}"
                                             Command="{Binding OpenFiltersCommand}"
                                             IsActive="{Binding HasActiveFilters}"
                                             BadgeCount="{Binding ActiveFilterCount}"
                                             ToolTip="{Binding FiltersButtonText}" />
                        <controls:IconButton Glyph="{Binding ViewModeIconGlyph}"
                                             Command="{Binding ToggleViewModeCommand}"
                                             ToolTip="{Binding ViewModeToolTip}" />
                        <controls:IconButton Glyph="{x:Static icons:Icons.Overflow}"
                                             Command="{Binding MoreCommand, Source={x:Reference CollectionPageRoot}}"
                                             ToolTip="More actions" />
                    </HorizontalStackLayout>
                </controls:SearchBarRow.Actions>
            </controls:SearchBarRow>

            <!-- Collection-only row filters (moved to sheet in a later step) -->
            <HorizontalStackLayout Spacing="{StaticResource Spacing8}"
                                   VerticalOptions="Center">
                <HorizontalStackLayout Spacing="{StaticResource Spacing4}"
                                       VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding CollectionFilterFoilOnly}"
                              VerticalOptions="Center"
                              Color="{StaticResource Primary}" />
                    <Label Text="Foil only"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="{StaticResource Spacing4}"
                                       VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding CollectionFilterEtchedOnly}"
                              VerticalOptions="Center"
                              Color="{StaticResource Primary}" />
                    <Label Text="Etched only"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Min copies"
                       FontSize="{StaticResource FontSizeCaption}"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center" />
                <Picker Title=""
                        ItemsSource="{Binding CollectionMinQtyPickerOptions}"
                        SelectedIndex="{Binding CollectionFilterMinQtyPickerIndex, Mode=TwoWay}"
                        FontSize="{StaticResource FontSizeCaption}"
                        TextColor="{StaticResource TextPrimary}"
                        WidthRequest="92"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="{StaticResource Spacing8}">
                <Label Grid.Column="0"
                       Text="{Binding CollectionStatsSummary}"
                       FontSize="{StaticResource FontSizeCaption}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center"
                       LineBreakMode="NoWrap" />

                <Label Grid.Column="1"
                       x:Name="CollectionStatus"
                       Text="{Binding StatusDisplayText}"
                       FontSize="{StaticResource FontSizeCaption}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{Binding StatusTextColor}"
                       IsVisible="{Binding ShowStatusLine}" />

                <HorizontalStackLayout Grid.Column="2"
                                       IsVisible="{Binding IsImportingPrices}"
                                       Spacing="{StaticResource Spacing4}"
                                       VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsImportingPrices}"
                                       HeightRequest="{StaticResource Spacing12}"
                                       WidthRequest="{StaticResource Spacing12}"
                                       Color="{StaticResource TextSecondary}" />
                    <Label Text="Prices…"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <ActivityIndicator Grid.Column="3"
                                   x:Name="CollectionLoading"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="{StaticResource Spacing16}"
                                   WidthRequest="{StaticResource Spacing16}"
                                   VerticalOptions="Center"
                                   Color="{StaticResource Primary}" />

                <Picker Grid.Column="4"
                        ItemsSource="{Binding SortModeOptions}"
                        SelectedIndex="{Binding SortModeIndex, Mode=TwoWay}"
                        Title="Sort"
                        FontSize="{StaticResource FontSizeCaption}"
                        TextColor="{StaticResource TextPrimary}"
                        WidthRequest="158"
                        VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <Grid x:Name="CollectionContentArea"
              Grid.Row="1"
              BackgroundColor="{StaticResource Background}">
            <Grid x:Name="CollectionEmptyState"
                  IsVisible="{Binding IsCollectionEmpty}"
                  BackgroundColor="{StaticResource Background}"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill"
                  MinimumHeightRequest="200">
                <controls:EmptyState IconGlyph="{x:Static icons:Icons.Collection}"
                                     Message="Your collection is empty" />
            </Grid>
            <controls:CardGrid x:Name="CollectionGrid"
                               IsVisible="{Binding IsCollectionEmpty, Converter={StaticResource InvertedBool}}"
                               Scrolled="OnCollectionScrolled"
                               UseCompactGrid="True" />
        </Grid>

    </Grid>

</ContentPage>
