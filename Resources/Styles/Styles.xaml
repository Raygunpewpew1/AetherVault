<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing (dp). Prefer these over ad-hoc 6/10/14. -->
    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>

    <!-- Type scale (phone base). Tablet/desktop scale via OnIdiom resources below. -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeadline">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">36</x:Double>

    <!-- Resolved font sizes: phone = token, tablet/desktop ≈ token × 1.3 (rounded). -->
    <OnIdiom x:Key="FontSizeCaptionIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>12</OnIdiom.Phone>
        <OnIdiom.Tablet>16</OnIdiom.Tablet>
        <OnIdiom.Desktop>16</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="FontSizeBodyIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>14</OnIdiom.Phone>
        <OnIdiom.Tablet>18</OnIdiom.Tablet>
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="FontSizeBodyLargeIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>16</OnIdiom.Phone>
        <OnIdiom.Tablet>20</OnIdiom.Tablet>
        <OnIdiom.Desktop>20</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="FontSizeTitleIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>20</OnIdiom.Phone>
        <OnIdiom.Tablet>26</OnIdiom.Tablet>
        <OnIdiom.Desktop>26</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="FontSizeHeadlineIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>24</OnIdiom.Phone>
        <OnIdiom.Tablet>32</OnIdiom.Tablet>
        <OnIdiom.Desktop>32</OnIdiom.Desktop>
    </OnIdiom>
    <OnIdiom x:Key="FontSizeDisplayIdiom" x:TypeArguments="x:Double">
        <OnIdiom.Phone>36</OnIdiom.Phone>
        <OnIdiom.Tablet>48</OnIdiom.Tablet>
        <OnIdiom.Desktop>48</OnIdiom.Desktop>
    </OnIdiom>

    <!-- Corner radii: Small / Large / Full (chips, FABs). -->
    <x:Double x:Key="CornerRadiusSmall">8</x:Double>
    <x:Double x:Key="CornerRadiusLarge">16</x:Double>
    <x:Double x:Key="CornerRadiusFull">999</x:Double>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyIdiom}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyIdiom}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyIdiom}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusSmall}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyIdiom}" />
    </Style>

    <Style x:Key="FloatingActionButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineIdiom}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Margin" Value="0,0,16,80" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="10"
                        Opacity="0.45" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="{StaticResource Spacing12}" />
    </Style>
</ResourceDictionary>
