<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:icons="clr-namespace:AetherVault.Core"
             xmlns:controls="clr-namespace:AetherVault.Controls"
             x:Class="AetherVault.Controls.CardSearchBar"
             x:Name="CardSearchBarRoot">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <material:TextField x:Name="SearchEntry"
                           Grid.Column="0"
                           Title="Search cards..."
                           Text="{Binding SearchText, Mode=TwoWay}"
                           ReturnCommand="{Binding SearchCommand}"
                           BackgroundColor="{StaticResource Surface}"
                           TextColor="{StaticResource TextPrimary}"
                           TitleColor="{StaticResource TextSecondary}"
                           AccentColor="{StaticResource Primary}"
                           AllowClear="True"
                           IsSpellCheckEnabled="False" />

        <Grid Grid.Column="1"
              WidthRequest="{StaticResource TouchTargetSize}"
              HeightRequest="{StaticResource TouchTargetSize}"
              VerticalOptions="Center">
            <controls:IconButton x:Name="FiltersButton"
                                 Glyph="{x:Static icons:Icons.Filter}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                                 IsActive="{Binding HasActiveFilters}"
                                 BadgeCount="{Binding ActiveFilterCount}"
                                 ToolTip="{Binding FiltersButtonText}" />
            <!-- Clicked wired in code-behind (FiltersCommand / FiltersTapped) -->
        </Grid>

        <controls:IconButton Grid.Column="2"
                             Glyph="{Binding ViewModeIconGlyph}"
                             Command="{Binding ToggleViewModeCommand}"
                             ToolTip="{Binding ViewModeToolTip}" />
    </Grid>
</ContentView>
