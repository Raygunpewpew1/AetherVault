<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AetherVault.Controls.TintedIcon"
             x:Name="Root">
    <Image Source="{Binding Glyph, Source={x:Reference Root}}"
           WidthRequest="{Binding Size, Source={x:Reference Root}}"
           HeightRequest="{Binding Size, Source={x:Reference Root}}"
           Aspect="AspectFit"
           HorizontalOptions="Center"
           VerticalOptions="Center">
        <Image.Behaviors>
            <toolkit:IconTintColorBehavior TintColor="{Binding TintColor, Source={x:Reference Root}}" />
        </Image.Behaviors>
    </Image>
</ContentView>
