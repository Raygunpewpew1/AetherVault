<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AetherVault.Controls.EmptyState"
             x:Name="Root">
    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="{StaticResource Spacing12}"
                         Padding="{StaticResource Spacing24}">
        <Border BackgroundColor="{StaticResource Surface1}"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 999"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                IsVisible="{Binding HasIcon, Source={x:Reference Root}}">
            <Image Source="{Binding IconGlyph, Source={x:Reference Root}}"
                   WidthRequest="{StaticResource FontSizeHeadline}"
                   HeightRequest="{StaticResource FontSizeHeadline}"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                </Image.Behaviors>
            </Image>
        </Border>
        <Label Text="{Binding Message, Source={x:Reference Root}}"
               Style="{StaticResource BodyLabel}"
               TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
