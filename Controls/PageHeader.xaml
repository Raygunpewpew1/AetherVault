<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AetherVault.Controls.PageHeader"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{StaticResource Spacing12}"
          VerticalOptions="Center"
          Padding="0,4">
        <VerticalStackLayout Spacing="{StaticResource Spacing4}"
                             VerticalOptions="Center">
            <BoxView HeightRequest="2"
                     WidthRequest="28"
                     Color="{StaticResource Primary}"
                     HorizontalOptions="Start"
                     CornerRadius="1" />
            <Label Text="{Binding Title, Source={x:Reference Root}}"
                   Style="{StaticResource TitleLabel}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
        <ContentView x:Name="TrailingHost"
                     Grid.Column="1"
                     VerticalOptions="Center"
                     HorizontalOptions="End" />
    </Grid>
</ContentView>
