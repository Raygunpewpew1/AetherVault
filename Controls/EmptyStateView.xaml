<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AetherVault.Controls.EmptyStateView"
             x:Name="Self">
    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="8"
                         BindingContext="{x:Reference Self}">
        <Image x:Name="IconImage"
               Source="{Binding IconGlyph}"
               WidthRequest="44"
               HeightRequest="44"
               Aspect="AspectFit"
               HorizontalOptions="Center">
            <Image.Behaviors>
                <toolkit:IconTintColorBehavior TintColor="{StaticResource TextSecondary}" />
            </Image.Behaviors>
        </Image>
        <Label Text="{Binding Message}"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{StaticResource TextPrimary}"
               HorizontalOptions="Center" />
        <Label Text="{Binding SecondaryMessage}"
               FontSize="13"
               TextColor="{StaticResource TextSecondary}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
