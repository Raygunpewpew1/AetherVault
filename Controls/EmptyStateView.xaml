<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AetherVault.Controls.EmptyStateView"
             x:Name="Self">
    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="{StaticResource Spacing12}"
                         Padding="{StaticResource Spacing24}"
                         BindingContext="{x:Reference Self}">
        <Border BackgroundColor="{StaticResource Surface1}"
                Stroke="{StaticResource BorderSubtle}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 999"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center">
            <Image x:Name="IconImage"
                   Source="{Binding IconGlyph}"
                   WidthRequest="28"
                   HeightRequest="28"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource Primary}" />
                </Image.Behaviors>
            </Image>
        </Border>
        <Label Text="{Binding Message}"
               Style="{StaticResource TitleLabel}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
        <Label Text="{Binding SecondaryMessage}"
               Style="{StaticResource CaptionLabel}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
