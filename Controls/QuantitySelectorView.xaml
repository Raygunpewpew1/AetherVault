<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:AetherVault.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="AetherVault.Controls.QuantitySelectorView"
             x:Name="QuantitySelectorRoot">
    <VerticalStackLayout Spacing="6" BindingContext="{x:Reference QuantitySelectorRoot}">
        <Label x:Name="HeaderLabel"
               Text="{Binding HeaderText}"
               FontSize="13"
               TextColor="{StaticResource TextSecondary}"
               HorizontalTextAlignment="Center" />
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" HorizontalOptions="Center" WidthRequest="260">
            <ImageButton x:Name="MinusBtn"
                         Clicked="OnMinusClicked"
                         WidthRequest="56"
                         HeightRequest="56"
                         CornerRadius="28"
                         Padding="16"
                         BackgroundColor="{StaticResource CardBackground}"
                         Source="{x:Static icons:Icons.Remove}"
                         Aspect="AspectFit">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource TextPrimary}" />
                </ImageButton.Behaviors>
            </ImageButton>
            <Label x:Name="QuantityLabel"
                   Grid.Column="1"
                   Text="{Binding Quantity}"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnQuantityLabelTapped" />
                </Label.GestureRecognizers>
            </Label>
            <ImageButton x:Name="PlusBtn"
                         Grid.Column="2"
                         Clicked="OnPlusClicked"
                         WidthRequest="56"
                         HeightRequest="56"
                         CornerRadius="28"
                         Padding="16"
                         BackgroundColor="{StaticResource CardBackground}"
                         Source="{x:Static icons:Icons.Add}"
                         Aspect="AspectFit">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="{StaticResource TextPrimary}" />
                </ImageButton.Behaviors>
            </ImageButton>
        </Grid>
    </VerticalStackLayout>
</ContentView>
